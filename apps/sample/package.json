{
  "name": "equinox-sample",
  "version": "0.1.0",
  "private": true,
  "description": "Sample app for @jeprubio/playwright-a11y: an accessible one-page site whose Playwright tests use the library. Not published.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:broken": "BROKEN=1 playwright test --project=chromium",
    "focus-map": "playwright test focus-map --project=chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@jeprubio/playwright-a11y": "*",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
